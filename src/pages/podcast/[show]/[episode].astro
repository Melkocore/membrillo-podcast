---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { withBase } from '../../../lib/paths';

export async function getStaticPaths() {
  const episodes = await getCollection('episodes', ({ data }) => !data.draft);
  return episodes.map((episode) => ({
    params: { show: episode.data.show, episode: episode.id },
    props: { episode },
  }));
}

const { episode } = Astro.props;
const { Content } = await render(episode);

const shows = await getCollection('shows');
const show = shows.find((entry) => entry.id === episode.data.show);

const date = new Intl.DateTimeFormat('es', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(episode.data.pubDate);

const accent = show?.data.accent ?? '#f0a63c';
---

<Base
  title={`${episode.data.title} — ${show?.data.title ?? 'Membrillo'}`}
  description={episode.data.description}
>
  <article class="mx-auto w-full max-w-3xl px-5 pb-20 pt-8 sm:px-8">
    <a
      href={withBase(`/podcast/${episode.data.show}`)}
      class="text-[10px] uppercase tracking-[0.25em] text-cream-dim/60 transition-colors hover:text-quince"
      >← {show?.data.title ?? 'Podcast'}</a
    >

    <header class="mt-6 border-b border-ink-line pb-8">
      <div
        class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[10px] uppercase tracking-[0.2em]"
      >
        <span style={`color:${accent}`}>{show?.data.title}</span>
        <time datetime={episode.data.pubDate.toISOString()} class="text-cream-dim/60"
          >{date}</time
        >
        {episode.data.duration && <span class="text-cream-dim/60">{episode.data.duration}</span>}
      </div>
      <h1
        class="mt-4 font-display text-3xl font-semibold leading-tight tracking-tight text-cream sm:text-4xl"
      >
        {episode.data.title}
      </h1>
      <p class="mt-3 text-sm leading-relaxed text-cream-dim sm:text-base">
        {episode.data.description}
      </p>
      {
        (episode.data.spotify || episode.data.youtube) && (
          <div class="mt-6 flex flex-wrap gap-3">
            {episode.data.spotify && (
              <a
                href={episode.data.spotify}
                class="border border-quince/60 px-4 py-2 text-[11px] uppercase tracking-[0.18em] text-quince transition-colors hover:bg-quince hover:text-ink"
              >
                Spotify
              </a>
            )}
            {episode.data.youtube && (
              <a
                href={episode.data.youtube}
                class="border border-ink-line px-4 py-2 text-[11px] uppercase tracking-[0.18em] text-cream-dim transition-colors hover:border-quince/60 hover:text-quince"
              >
                YouTube
              </a>
            )}
          </div>
        )
      }
    </header>

    <div class="prose-membrillo mt-8 text-sm sm:text-base">
      <Content />
    </div>
  </article>
</Base>
