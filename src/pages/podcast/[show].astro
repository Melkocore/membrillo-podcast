---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EpisodeCard from '../../components/EpisodeCard.astro';
import { withBase } from '../../lib/paths';

export async function getStaticPaths() {
  const shows = await getCollection('shows', ({ data }) => !data.draft);
  return shows.map((show) => ({
    params: { show: show.id },
    props: { show },
  }));
}

const { show } = Astro.props;
const { Content } = await render(show);

const episodes = (
  await getCollection(
    'episodes',
    ({ data }) => data.show === show.id && !data.draft,
  )
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base
  title={`${show.data.title} — Membrillo`}
  description={show.data.description}
>
  <section class="mx-auto w-full max-w-6xl px-5 pb-20 pt-8 sm:px-8">
    <a
      href={withBase('/podcast')}
      class="text-[10px] uppercase tracking-[0.25em] text-cream-dim/60 transition-colors hover:text-quince"
      >← Podcast</a
    >

    <div class="mt-6 border-b border-ink-line pb-10">
      <p
        class="text-[10px] uppercase tracking-[0.28em]"
        style={`color:${show.data.accent}`}
      >
        {show.data.tagline}
      </p>
      <h1
        class="mt-3 font-display text-4xl font-semibold tracking-tight text-cream sm:text-5xl"
      >
        {show.data.title}
      </h1>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-cream-dim sm:text-base">
        {show.data.description}
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-[10px] uppercase tracking-[0.2em] text-cream-dim/60">
        <span>Con {show.data.hosts.join(' · ')}</span>
        {
          show.data.spotify && (
            <a
              href={show.data.spotify}
              class="text-quince transition-opacity hover:opacity-70"
            >
              Escuchar en Spotify →
            </a>
          )
        }
      </div>
    </div>

    <div class="prose-membrillo mt-10 max-w-2xl text-sm sm:text-base">
      <Content />
    </div>

    <div class="mt-14">
      <h2
        class="font-display text-2xl font-semibold tracking-tight text-cream"
      >
        Episodios
      </h2>
      {
        episodes.length === 0 ? (
          <p class="mt-4 text-sm text-cream-dim">
            Todavía no hay episodios publicados.
          </p>
        ) : (
          <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {episodes.map((episode) => (
              <EpisodeCard
                episode={episode}
                showTitle={show.data.title}
                accent={show.data.accent}
              />
            ))}
          </div>
        )
      }
    </div>
  </section>
</Base>
