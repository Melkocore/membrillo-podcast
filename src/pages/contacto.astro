---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
---

<Base
  title="Contacto — Membrillo"
  description="Escribinos para proponer colaboraciones, invitaciones o ideas."
>
  <section class="mx-auto w-full max-w-3xl px-5 pb-20 pt-8 sm:px-8">
    <p class="text-[10px] uppercase tracking-[0.35em] text-quince">Contacto</p>
    <h1
      class="mt-3 font-display text-4xl font-semibold leading-tight tracking-tight text-cream sm:text-5xl"
    >
      Escribinos
    </h1>
    <p class="mt-4 max-w-xl text-sm leading-relaxed text-cream-dim">
      Ideas, colaboraciones, invitaciones a funciones o simplemente una
      recomendación. Leemos todo.
    </p>

    <a
      href={`mailto:${site.email}`}
      class="mt-10 block border border-ink-line bg-ink-soft/60 p-6 transition-colors hover:border-quince/50 sm:p-8"
    >
      <span class="text-[10px] uppercase tracking-[0.25em] text-cream-dim/60"
        >Correo</span
      >
      <span
        class="mt-3 block break-all font-display text-2xl text-cream transition-colors hover:text-quince sm:text-3xl"
        >{site.email}</span
      >
    </a>

    <div class="mt-8">
      <p class="text-[10px] uppercase tracking-[0.25em] text-cream-dim/60">
        También en
      </p>
      <ul class="mt-4 flex flex-wrap gap-3">
        {
          site.socials.map((social) => (
            <li>
              <a
                href={social.href}
                class="inline-block border border-ink-line px-4 py-2 text-[11px] uppercase tracking-[0.16em] text-cream-dim transition-colors hover:border-quince/60 hover:text-quince"
                rel="noopener noreferrer"
                target="_blank"
              >
                {social.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
