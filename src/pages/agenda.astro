---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const events = await getCollection('events', ({ data }) => !data.draft);
const now = new Date();

const byDate = (a: (typeof events)[number], b: (typeof events)[number]) =>
  a.data.startDate.valueOf() - b.data.startDate.valueOf();

const upcoming = events
  .filter((event) => event.data.startDate >= now)
  .sort(byDate);
const past = events
  .filter((event) => event.data.startDate < now)
  .sort((a, b) => byDate(b, a));

const dateFormat = new Intl.DateTimeFormat('es', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const timeFormat = new Intl.DateTimeFormat('es', {
  hour: '2-digit',
  minute: '2-digit',
});
---

<Base
  title="Agenda — Membrillo"
  description="Próximas funciones, escuchas colectivas y encuentros de Membrillo."
>
  <section class="mx-auto w-full max-w-6xl px-5 pb-20 pt-8 sm:px-8">
    <p class="text-[10px] uppercase tracking-[0.35em] text-quince">Encuentros</p>
    <h1
      class="mt-3 font-display text-4xl font-semibold tracking-tight text-cream sm:text-5xl"
    >
      Agenda
    </h1>
    <p class="mt-4 max-w-xl text-sm leading-relaxed text-cream-dim">
      Funciones, escuchas y conversaciones para encontrarnos fuera de los
      auriculares.
    </p>

    <div class="mt-12">
      <h2
        class="text-[10px] uppercase tracking-[0.3em] text-cream-dim/60"
      >
        Próximamente
      </h2>
      {
        upcoming.length === 0 ? (
          <p class="mt-4 border border-ink-line bg-ink-soft/60 p-6 text-sm text-cream-dim">
            No hay fechas confirmadas por ahora. Volvé pronto.
          </p>
        ) : (
          <div class="mt-4 space-y-4">
            {upcoming.map((event) => (
              <article class="border border-ink-line bg-ink-soft/60 p-6 sm:p-8">
                <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
                  <div class="max-w-2xl">
                    <time
                      datetime={event.data.startDate.toISOString()}
                      class="text-[10px] uppercase tracking-[0.2em] text-quince"
                    >
                      {dateFormat.format(event.data.startDate)} · {timeFormat.format(event.data.startDate)} h
                    </time>
                    <h3 class="mt-2 font-display text-2xl leading-snug text-cream">
                      {event.data.title}
                    </h3>
                    <p class="mt-2 text-sm leading-relaxed text-cream-dim">
                      {event.data.description}
                    </p>
                    <p class="mt-4 text-[10px] uppercase tracking-[0.2em] text-cream-dim/60">
                      {event.data.location}
                      {event.data.city && ` · ${event.data.city}`}
                    </p>
                  </div>
                  {event.data.url && (
                    <a
                      href={event.data.url}
                      class="shrink-0 border border-quince/60 px-4 py-2 text-center text-[11px] uppercase tracking-[0.18em] text-quince transition-colors hover:bg-quince hover:text-ink"
                    >
                      Más info
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
        )
      }
    </div>

    {
      past.length > 0 && (
        <div class="mt-14">
          <h2 class="text-[10px] uppercase tracking-[0.3em] text-cream-dim/60">
            Ya pasó
          </h2>
          <ul class="mt-4 divide-y divide-ink-line border-y border-ink-line">
            {past.map((event) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4">
                <span class="text-sm text-cream">{event.data.title}</span>
                <span class="text-[10px] uppercase tracking-[0.2em] text-cream-dim/50">
                  {dateFormat.format(event.data.startDate)}
                </span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>
</Base>
