---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
---

<Base
  title="Redes — Membrillo"
  description="Seguí a Membrillo en redes sociales."
>
  <section class="mx-auto w-full max-w-3xl px-5 pb-20 pt-8 sm:px-8">
    <p class="text-[10px] uppercase tracking-[0.35em] text-quince">Redes</p>
    <h1
      class="mt-3 font-display text-4xl font-semibold tracking-tight text-cream sm:text-5xl"
    >
      Seguinos
    </h1>
    <p class="mt-4 max-w-xl text-sm leading-relaxed text-cream-dim">
      Novedades, recomendaciones y el detrás de escena. Elegí dónde
      encontrarnos.
    </p>

    <ul class="mt-10 divide-y divide-ink-line border-y border-ink-line">
      {
        site.socials.map((social) => (
          <li>
            <a
              href={social.href}
              class="group flex items-baseline justify-between gap-6 py-5"
              rel="noopener noreferrer"
              target="_blank"
            >
              <span class="font-display text-xl text-cream transition-colors group-hover:text-quince">
                {social.label}
              </span>
              <span class="flex items-baseline gap-3 text-[11px] uppercase tracking-[0.18em] text-cream-dim/60">
                {social.handle}
                <span class="text-quince" aria-hidden="true">↗</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
