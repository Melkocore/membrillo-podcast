---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/paths';

const news = (
  await getCollection('news', ({ data }) => !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const dateFormat = new Intl.DateTimeFormat('es', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Base
  title="Noticias — Membrillo"
  description="Novedades, estrenos y notas del proyecto Membrillo."
>
  <section class="mx-auto w-full max-w-6xl px-5 pb-20 pt-8 sm:px-8">
    <p class="text-[10px] uppercase tracking-[0.35em] text-quince">Bitácora</p>
    <h1
      class="mt-3 font-display text-4xl font-semibold tracking-tight text-cream sm:text-5xl"
    >
      Noticias
    </h1>
    <p class="mt-4 max-w-xl text-sm leading-relaxed text-cream-dim">
      Lo que pasa en Membrillo y alrededor: estrenos, episodios nuevos y
      proyectos en marcha.
    </p>

    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {
        news.map((entry) => (
          <a
            href={withBase(`/noticias/${entry.id}`)}
            class="group border border-ink-line bg-ink-soft/60 p-6 transition-colors hover:border-quince/50 sm:p-8"
          >
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
              <time
                datetime={entry.data.pubDate.toISOString()}
                class="text-[10px] uppercase tracking-[0.2em] text-cream-dim/60"
              >
                {dateFormat.format(entry.data.pubDate)}
              </time>
              {entry.data.tags.map((tag) => (
                <span class="text-[10px] uppercase tracking-[0.16em] text-quince/80">
                  {tag}
                </span>
              ))}
            </div>
            <h2 class="mt-3 font-display text-2xl leading-snug text-cream transition-colors group-hover:text-quince">
              {entry.data.title}
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-cream-dim">
              {entry.data.summary}
            </p>
          </a>
        ))
      }
    </div>
  </section>
</Base>
