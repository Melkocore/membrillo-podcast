---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/paths';

export async function getStaticPaths() {
  const news = await getCollection('news', ({ data }) => !data.draft);
  return news.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const date = new Intl.DateTimeFormat('es', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(entry.data.pubDate);
---

<Base title={`${entry.data.title} — Membrillo`} description={entry.data.summary}>
  <article class="mx-auto w-full max-w-3xl px-5 pb-20 pt-8 sm:px-8">
    <a
      href={withBase('/noticias')}
      class="text-[10px] uppercase tracking-[0.25em] text-cream-dim/60 transition-colors hover:text-quince"
      >← Noticias</a
    >

    <header class="mt-6 border-b border-ink-line pb-8">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <time
          datetime={entry.data.pubDate.toISOString()}
          class="text-[10px] uppercase tracking-[0.2em] text-cream-dim/60"
          >{date}</time
        >
        {
          entry.data.tags.map((tag) => (
            <span class="text-[10px] uppercase tracking-[0.16em] text-quince/80">
              {tag}
            </span>
          ))
        }
      </div>
      <h1
        class="mt-4 font-display text-3xl font-semibold leading-tight tracking-tight text-cream sm:text-4xl"
      >
        {entry.data.title}
      </h1>
      <p class="mt-3 text-sm leading-relaxed text-cream-dim sm:text-base">
        {entry.data.summary}
      </p>
    </header>

    <div class="prose-membrillo mt-8 text-sm sm:text-base">
      <Content />
    </div>
  </article>
</Base>
