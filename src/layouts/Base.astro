---
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import { site } from '../config/site';
import { withBase } from '../lib/paths';
import AmbientDock from '../components/AmbientDock';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} — ${site.tagline}`,
  description = site.description,
} = Astro.props;

const path = Astro.url.pathname;
const nav = [
  { href: '/podcast', label: 'Podcast' },
  { href: '/noticias', label: 'Noticias' },
  { href: '/agenda', label: 'Agenda' },
  { href: '/proyecto', label: 'Proyecto' },
  { href: '/redes', label: 'Redes' },
  { href: '/contacto', label: 'Contacto' },
];

const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0908" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col font-sans text-cream">
    <header
      class="relative z-20 mx-auto flex w-full max-w-6xl items-center justify-between gap-6 px-5 py-5 sm:px-8"
    >
      <a href={withBase('/')} class="group flex items-baseline gap-2">
        <span
          class="font-display text-base font-semibold uppercase tracking-[0.3em] transition-colors group-hover:text-quince"
          >{site.name}</span
        >
        <span
          class="hidden text-[10px] uppercase tracking-[0.2em] text-cream-dim/60 sm:inline"
          >{site.tagline}</span
        >
      </a>
      <nav aria-label="Secciones">
        <ul
          class="flex flex-wrap items-center justify-end gap-x-4 gap-y-1 text-[10px] uppercase tracking-[0.18em] sm:gap-x-5"
        >
          {
            nav.map((item) => (
              <li>
                <a
                  href={withBase(item.href)}
                  class:list={[
                    'transition-colors hover:text-quince',
                    isActive(item.href) ? 'text-quince' : 'text-cream-dim',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main class="relative z-10 flex-1">
      <slot />
    </main>

    <footer class="relative z-20 mx-auto w-full max-w-6xl px-5 py-8 sm:px-8">
      <div
        class="flex flex-col gap-4 border-t border-ink-line pt-6 text-[11px] uppercase tracking-[0.18em] text-cream-dim/70 sm:flex-row sm:items-center sm:justify-between"
      >
        <p>© {new Date().getFullYear()} {site.name}</p>
        <p>Hecho con tiempo, cine y música</p>
      </div>
    </footer>

    {!path.startsWith('/laboratorio') && <AmbientDock client:load />}
  </body>
</html>
